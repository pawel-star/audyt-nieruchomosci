{
  "manifest_version": 3,
  "name": "Szukacz nieruchomości – skaner ogłoszeń",
  "version": "1.4.1",
  "description": "Ocenia ogłoszenia na grupach Facebooka i stronach biur według profilu z aplikacji Szukacz nieruchomości.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Szukacz nieruchomości",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.facebook.com/*"
  ]
}